{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "ESPHome: Dashboard",
      "command": "dashboard.cmd",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "process",
      "label": "ESPHome: Compile",
      "command": "esphome.cmd",
      "args": [
        "compile",
        "${fileBasename}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "esphome",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/esphome"
        ],
        "pattern": {
          "regexp": "in \"([^\"]+)\", line (\\d+), column (\\d+)",
          "file": 1,
          "line": 2,
          "column": 3
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}